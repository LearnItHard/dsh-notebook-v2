{
  "name": "dsh-notebook-v2",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "DSH 右栏自研 Jupyter notebook 面板：常驻内核、流式输出、.ipynb 语义等价读写、内联 AI 改写与补全",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LearnItHard/dsh-notebook-v2.git"
  },
  "homepage": "https://github.com/LearnItHard/dsh-notebook-v2#readme",
  "bugs": {
    "url": "https://github.com/LearnItHard/dsh-notebook-v2/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "jupyter",
    "notebook",
    "ipynb",
    "codemirror"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "python",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "title": "Notebook (v2)",
    "description": "流式 Jupyter（自研）。与旧插件 @beihaizb/dsh-notebook 并存，数据不动。",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
